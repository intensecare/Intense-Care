# ============================================================================
# Deep Cleaning Operations ERP — environment template
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ============================================================================

# --- Database (Neon Postgres or any Postgres) --------------------------------
# Connection string with ?sslmode=require for hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Session signing -----------------------------------------------------------
# 32-byte hex secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
ERP_SESSION_SECRET=""
# Server-side session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- SMS / OTP provider (2Factor.in) ------------------------------------------
# API key from the 2Factor dashboard. Required for customer arrival OTPs —
# the app intentionally has no mock/dummy OTP mode.
TWOFACTOR_API_KEY=""
# Optional DLT sender id if you have your own registration.
TWOFACTOR_SENDER_ID=""
# OTP delivery mode. Leave unset for 2Factor AUTOGEN (provider generates and
# verifies the code through its SHARED pre-approved template — no DLT needed).
# KNOWN ISSUE: on some accounts the shared-template AUTOGEN route silently
# swallows delivery (provider returns Success + session id, handsets never
# receive the SMS). Escape hatches, in order of preference:
#
# 1) autogen_template — set TWOFACTOR_OTP_TEMPLATE to YOUR DLT-registered
#    OTP template name. The provider still generates and verifies the code
#    (session VERIFY flow unchanged), but delivery goes through your own
#    template + sender id (/SMS/{phone}/AUTOGEN/{template_name}). Also set
#    TWOFACTOR_SENDER_ID to your 6-char DLT header if you have one.
# 2) template — additionally set TWOFACTOR_OTP_LOCAL_CODE=1 to generate the
#    6-digit code locally, deliver through your template (VAR1) and verify
#    the SHA-256 hash in the database (no provider session involved).
# TWOFACTOR_OTP_TEMPLATE=""
# TWOFACTOR_OTP_LOCAL_CODE=""
# Super_admins can verify live account credits and the active OTP delivery
# mode at Settings → SMS Gateway Health → Check Live (GET /api/sms/balance)
# without sending any SMS.

# --- Image storage (Cloudinary) ------------------------------------------------
# Required for before/after evidence photo uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder under which job photos are stored.
CLOUDINARY_FOLDER="deep-cleaning-erp"

# --- Operational policy (server-enforced; safe defaults if omitted) ------------
# Ops Manager dispatch cutoff "HH:MM" local — tomorrow's jobs unlock at this time.
NEXT_DAY_DISPATCH_TIME="20:00"
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_SENDS_PER_JOB_PER_HOUR="5"
OTP_MAX_SENDS_PER_PHONE_PER_HOUR="10"
PORTAL_LINK_EXPIRY_DAYS="30"

# --- Misc ----------------------------------------------------------------------
# Public base URL used in SMS/portal links (falls back to the request origin).
# Public origin used in customer-facing links (portal handover, statements).
# Set this to the DEPLOYED domain in production (e.g. https://intense-care.vercel.app)
# so links minted from local/preview environments still resolve for customers.
# When unset, links use the request's own origin (correct on same-origin use).
APP_BASE_URL=""
# debug | info | warn | error
LOG_LEVEL="info"

# --- First-run seed (npm run db:seed) -------------------------------------------
# Credentials for the initial super_admin account. Remove after seeding.
SEED_SUPERADMIN_EMAIL="admin@yourcompany.com"
SEED_SUPERADMIN_PASSWORD="change-me-at-least-8-chars"
SEED_SUPERADMIN_PHONE=""

# --- OTP dev mode (NEVER set in production) ---------------------------------
# When 1, OTPs are generated locally and returned in the API response instead of
# being sent via SMS. Local development / staging only.
OTP_DEV_MODE=0
