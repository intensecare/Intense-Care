# ============================================================================
# Laundry Operations — environment template. Copy to `.env`; never commit it.
# ============================================================================

# PostgreSQL connection string (Neon, Supabase, RDS, local …).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Signs staff sessions AND customer order links. 32+ random characters:
#   openssl rand -hex 32
# Changing it signs everyone out and invalidates every customer link.
SESSION_SECRET=""
SESSION_TTL_HOURS="12"

# Public URL used in customer links and WhatsApp messages (your real domain).
APP_BASE_URL="https://laundry.example.com"

# Business day boundary for "today" (minutes from UTC; IST = 330) and display timezone.
BUSINESS_TZ_OFFSET_MINUTES="330"
NEXT_PUBLIC_BUSINESS_TIMEZONE="Asia/Kolkata"

# --- WhatsApp (optional) — WhatsApp Business Cloud API ------------------------
# Without these, messages are logged (Admin → Settings) but not sent.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Business-initiated messages need an approved template with ONE body
# variable ({{1}}); the full update text is passed into it. Leave empty to
# send plain text (only delivered inside the 24-hour customer-care window).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_API_VERSION="v20.0"

# --- Pickup photos (optional) — Cloudinary ----------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="laundry"

LOG_LEVEL="info"

# --- First admin (npm run db:seed) -------------------------------------------
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_PASSWORD="change-me-at-least-8-chars"
SEED_ADMIN_PHONE=""
# 1 = also add a starter price list (only when no services exist).
SEED_STARTER_SERVICES="0"
