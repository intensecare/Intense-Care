<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing from this app (login, contact-sync state, queued photos) is copied to cloud backup or to a new phone. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
