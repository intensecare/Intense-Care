// Prisma schema — the database is the SINGLE SOURCE OF TRUTH for the entire
// ERP. Every operational record (users, customers, properties, services,
// jobs, checklists, QC, referrals, finance) lives here; the client UI is a
// hydrated view with write-through actions. Nothing is hardcoded in the UI:
// service packages, rubrics, commission rules, and settings are all
// company-managed data created through the app itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Login account. `role` is one of the sign-in roles (src/lib/rbac/roles.ts):
/// admin | field_manager | qc_inspector | tax_officer. Customers never sign
/// in — they use the ONE secure link / QR of their job.
model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String
  role              String // admin | field_manager | qc_inspector | tax_officer
  avatar            String?
  passwordHash      String? // bcrypt hash; null = password login disabled until set
  active            Boolean  @default(true)
  teamId            String?
  branchId          String?
  customerId        String?
  referralPartnerId String?
  createdAt         DateTime @default(now())

  @@index([role])
  @@index([customerId])
  @@index([referralPartnerId])
  @@index([teamId])
}

model Customer {
  id                String   @id @default(cuid())
  name              String
  phone             String
  email             String   @default("")
  type              String   @default("individual") // "individual" | "commercial"
  address           String   @default("")
  notes             String?
  source            String   @default("direct") // direct | referral | google | repeat
  referralPartnerId String?
  referralCode      String?
  gstin             String? // optional — shown on GST invoices for business customers
  lifetimeRevenue   Float    @default(0)
  totalBookings     Int      @default(0)
  status            String   @default("active") // active | inactive
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  properties   Property[]
  jobs         Job[]
  amcContracts AmcContract[]

  @@index([phone])
}

model Property {
  id                  String   @id @default(cuid())
  customerId          String
  title               String
  address             String
  propertyType        String   @default("apartment") // apartment | villa | office | penthouse | commercial | duplex
  city                String   @default("")
  postalCode          String?
  bedrooms            Int      @default(1)
  bathrooms           Int      @default(1)
  areaSqFt            Int      @default(1000)
  // §11 GPS coordinates for arrival geofencing (null = not captured yet;
  // arrival then requires an explicit bypass reason until coords are set).
  lat                 Float?
  lng                 Float?
  accessCode          String?
  accessNotes         String?
  parkingInstructions String?
  preferredTime       String?
  recurringService    Boolean  @default(false)
  recurringFrequency  String?
  createdAt           DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs         Job[]
  amcContracts AmcContract[]

  @@index([customerId])
}

model Service {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  category               String   @default("residential")
  description            String
  basePrice              Float
  estimatedDurationHours Float
  active                 Boolean  @default(true)
  /// Custom (one-off / bespoke) service vs the standard catalogue.
  isCustom               Boolean  @default(false)
  /// DEFAULT (company setting) | GST | NON_GST
  gstTreatment           String   @default("DEFAULT")
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  checklistTemplate ServiceChecklistItem[]
  jobs              Job[]

  @@index([active])
}

/// A company-authored quality rubric step that belongs to a service package.
/// Jobs instantiate copies of these as JobChecklistItem records at booking.
model ServiceChecklistItem {
  id        String  @id @default(cuid())
  serviceId String
  area      String
  task      String
  critical  Boolean @default(false)
  position  Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Job {
  id                      String    @id @default(cuid())
  customerId              String
  propertyId              String
  serviceId               String
  scheduledDate           String
  scheduledTimeSlot       String
  assignedManagerId       String?
  assignedStaffIds        String[]  @default([]) // directly-assigned field worker ids (first entry = lead worker)
  amount                  Float
  paymentStatus           String    @default("UNPAID")
  status                  String    @default("SCHEDULED")
  notes                   String?
  qualityCheckId          String?
  referralPartnerId       String?
  arrivedAt               DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  googleEventId           String? // §1 Google Calendar — event synced for this job (null = not connected)
  // §11 GPS-verified arrival: the coordinates the manager reported when they
  // tapped [ARRIVED] and how the gate decided. arrivalVerification = "gps"
  // (inside geofence) | "manual" (outside/unavailable + explicit reason). The
  // distance is stored (metres) so the audit timeline can show the verdict.
  arrivalLat              Float?
  arrivalLng              Float?
  arrivalAccuracy         Float?
  arrivalVerification     String?
  arrivalDistanceM        Float?
  arrivalBypassReason     String?
  customerConfirmedAt     DateTime?
  // Unified QR/link workflow wiring (§3): the customer-confirmation token and
  // the current QR tokens resolve back to this single Job ID — never a copy.
  jobSerial               String    @unique // readable Job ID, e.g. RAHUL-SHARMA-08102026-001
  customerTokenId         String?
  approvedAt              DateTime?
  approvedBy              String?
  approvalMethod          String?
  // §24 unified-journey feedback: star rating captured on the customer's
  // secure approval link right after they approve completion.
  customerFeedbackRating  Int?
  customerFeedbackAt      DateTime?
  googleReviewClicked     Boolean   @default(false)
  customerFeedbackComment String?
  /// Service location for THIS job (map pin). Defaults to the property's.
  locationLat             Float?
  locationLng             Float?
  locationAddress         String?
  /// What the customer may see on their QR page; null = company defaults
  /// (Settings → Customer Portal). Enforced by the customer API.
  customerVisibility      Json?
  /// Notes written for the customer. Internal notes stay in `notes`.
  customerNotes           String?
  quoteId                 String?
  /// Skills the crew needs, expected duration and instructions for the team.
  requiredSkills          String[]  @default([])
  specialInstructions     String?
  expectedDurationHours   Float?
  /// Set when Admin confirms the team (and the team is notified).
  assignmentConfirmedAt   DateTime?
  assignmentConfirmedBy   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer          Customer             @relation(fields: [customerId], references: [id])
  property          Property             @relation(fields: [propertyId], references: [id])
  service           Service              @relation(fields: [serviceId], references: [id])
  referralPartner   ReferralPartner?     @relation("JobAttribution", fields: [referralPartnerId], references: [id])
  checklistItems    JobChecklistItem[]
  invoices          Invoice[]
  photos            JobPhoto[]
  qualityChecks     QualityCheck[]
  reworkTasks       ReworkTask[]
  complaints        Complaint[]
  commissionEntries CommissionEntry[]
  qrTokens          QrToken[]
  assignments       JobAssignment[]
  assignmentEvents  JobAssignmentEvent[]
  attendanceRecords AttendanceRecord[]
  freelancePayments FreelancePayment[]

  @@index([scheduledDate])
  @@index([status])
  @@index([scheduledDate, status])
}

/// Per-job working checklist, instantiated from the service's rubric at
/// booking time. Each item is completed/skipped/flagged by field workers.
model JobChecklistItem {
  id            String    @id @default(cuid())
  jobId         String
  area          String
  task          String
  critical      Boolean   @default(false)
  status        String    @default("pending") // pending | completed | skipped | issue
  skippedReason String?
  issueNotes    String?
  photoEvidence String?
  completedBy   String?
  completedAt   DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  jobId          String
  customerId     String
  subtotal       Float
  tax            Float
  discount       Float     @default(0)
  total          Float
  amountPaid     Float     @default(0)
  balanceDue     Float
  dueDate        String
  status         String    @default("UNPAID") // UNPAID | PARTIAL | PAID | REFUNDED | CANCELLED
  issuedAt       DateTime  @default(now())
  /// Set when Accounts finalizes the invoice; line amounts are frozen after this.
  finalizedAt    DateTime?
  finalizedBy    String?
  /// Running total of approved refunds against this invoice.
  refundedAmount Float     @default(0)
  /// GST | NON_GST — chosen by Admin when the invoice is created. A Non-GST
  /// invoice never carries GST data (enforced by a DB check constraint).
  /// Tax Officers can only ever read GST invoices (enforced in every API).
  invoiceType    String
  /// GST % applied (e.g. 18). 0 on Non-GST invoices.
  gstRate        Float     @default(0)
  cgst           Float     @default(0)
  sgst           Float     @default(0)
  igst           Float     @default(0)
  /// Inter-state supply → IGST; intra-state → CGST + SGST.
  interState     Boolean   @default(false)
  customerGstin  String?
  /// Company GSTIN at the time the invoice was issued.
  supplierGstin  String?
  /// Line items [{ description, quantity, rate, amount }]; null = one line for the job's service.
  items          Json?
  notes          String?
  paymentTerms   String?
  billingAddress String?
  serviceAddress String?
  quoteId        String?

  job      Job       @relation(fields: [jobId], references: [id])
  payments Payment[]
  refunds  Refund[]

  @@index([jobId])
  @@index([customerId])
  @@index([invoiceType, issuedAt])
}

/// Refund against an invoice. Refunds up to the configured limit are
/// processed by Accounts; above it the record waits in PENDING_APPROVAL until
/// an Operations Manager or Super Admin approves (approval authority §17).
model Refund {
  id          String    @id @default(cuid())
  invoiceId   String
  jobId       String
  customerId  String
  amount      Float
  reason      String
  method      String // original | bank_transfer | upi | cash
  status      String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | PROCESSED
  requestedBy String
  approvedBy  String?
  approvedAt  DateTime?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model Payment {
  id                   String   @id @default(cuid())
  invoiceId            String
  jobId                String
  customerId           String
  amount               Float
  paymentMethod        String // card | bank_transfer | cash | upi | online_link
  transactionReference String
  status               String   @default("completed")
  paidAt               DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([jobId])
}

model QualityCheck {
  id          String   @id @default(cuid())
  jobId       String
  inspectorId String
  score       Int
  decision    String // "PASS" | "REWORK_REQUIRED"
  notes       String?
  createdAt   DateTime @default(now())

  job    Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  issues QualityIssue[]

  @@index([jobId])
}

model QualityIssue {
  id                 String    @id @default(cuid())
  qualityCheckId     String?
  jobId              String
  area               String
  itemDescription    String
  severity           String    @default("minor") // minor | major | critical
  notes              String?
  status             String    @default("rework_in_progress") // rework_in_progress | resolved | reinspected_pass
  reworkTaskId       String?
  assignedStaffId    String?
  reworkInstructions String?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  qualityCheck QualityCheck? @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([qualityCheckId])
}

model ReworkTask {
  id              String    @id @default(cuid())
  qualityIssueId  String
  jobId           String
  assignedStaffId String?
  instructions    String
  status          String    @default("pending") // pending | in_progress | completed
  completedNotes  String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([assignedStaffId])
}

model Complaint {
  id                String    @id @default(cuid())
  jobId             String
  customerId        String
  category          String // quality | punctuality | staff_behavior | damage | missed_area | billing
  severity          String    @default("high")
  description       String
  assignedOwnerId   String?
  assignedOwnerName String?
  status            String    @default("open")
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

/// Evidence photo for a job (before/after), stored in Cloudinary. The database
/// keeps only the Cloudinary identifiers/URLs and metadata — never image bytes.
model JobPhoto {
  id                 String   @id @default(cuid())
  jobId              String
  area               String // "Kitchen", "Master Bathroom", ...
  photoType          String // "before" | "after"
  cloudinaryPublicId String
  photoUrl           String // Cloudinary secure delivery URL
  thumbnailUrl       String?
  bytes              Int?
  width              Int?
  height             Int?
  format             String?
  caption            String?
  uploadedByUserId   String
  uploadedByName     String
  uploadedAt         DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Quote {
  id             String    @id @default(cuid())
  quoteNumber    String    @unique
  customerId     String
  propertyId     String?
  /// First standard service (legacy); the lines live in `items`.
  serviceId      String?
  /// [{ serviceId?, description, quantity, rate, amount, custom }]
  items          Json?
  quoteType      String    @default("GST") // GST | NON_GST
  gstRate        Float     @default(0)
  cgst           Float     @default(0)
  sgst           Float     @default(0)
  igst           Float     @default(0)
  interState     Boolean   @default(false)
  customerGstin  String?
  subtotal       Float
  tax            Float
  discount       Float     @default(0)
  total          Float
  validUntil     String
  terms          String?
  paymentTerms   String?
  notes          String?
  /// draft | sent | accepted | declined | converted_to_job | expired
  status         String    @default("sent")
  acceptedAt     DateTime?
  acceptedBy     String?
  /// Share link for the customer to view/accept: only the hash is stored.
  shareTokenHash String?   @unique
  shareTokenEnc  String?
  jobId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([customerId])
}

model ReferralPartner {
  id                     String   @id @default(cuid())
  name                   String
  code                   String   @unique
  partnerType            String   @default("interior_designer")
  email                  String   @default("")
  phone                  String   @default("")
  commissionRuleId       String?
  status                 String   @default("active")
  totalReferrals         Int      @default(0)
  totalConversions       Int      @default(0)
  totalRevenueGenerated  Float    @default(0)
  totalCommissionEarned  Float    @default(0)
  totalCommissionPaid    Float    @default(0)
  totalCommissionPending Float    @default(0)
  bankAccountName        String?
  bankAccountNumber      String?
  bankIfscOrRouting      String?
  bankUpiId              String?
  createdAt              DateTime @default(now())

  commissionRule    CommissionRule?   @relation(fields: [commissionRuleId], references: [id])
  commissionEntries CommissionEntry[]
  payouts           Payout[]
  attributedJobs    Job[]             @relation("JobAttribution")

  @@index([status])
}

model CommissionRule {
  id               String   @id @default(cuid())
  name             String
  partnerType      String   @default("interior_designer")
  calculationType  String   @default("percentage") // percentage | fixed | tiered | service_specific
  value            Float    @default(10)
  tierRules        Json?
  serviceOverrides Json?
  isDefault        Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  partners ReferralPartner[]
}

model CommissionEntry {
  id               String    @id @default(cuid())
  partnerId        String
  referralId       String?
  jobId            String
  bookingAmount    Float
  commissionAmount Float
  ruleApplied      String
  status           String    @default("COMMISSION_PENDING")
  approvedAt       DateTime?
  payoutId         String?
  reversedReason   String?
  createdAt        DateTime  @default(now())

  partner ReferralPartner @relation(fields: [partnerId], references: [id])
  job     Job             @relation(fields: [jobId], references: [id])

  @@index([partnerId])
  @@index([jobId])
  @@index([status])
  @@index([partnerId, status])
}

model Payout {
  id              String   @id @default(cuid())
  partnerId       String
  partnerName     String
  amount          Float
  payoutMethod    String // bank_transfer | upi | cheque | wallet
  referenceNumber String
  status          String   @default("paid")
  paidAt          DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  partner ReferralPartner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

/// Business expenses and job costs. `amount` is the TOTAL paid (tax included);
/// `taxAmount` is the GST part of it. Payroll, freelance payments and referral
/// bonuses create their expense row only when they are PAID (`sourceType` +
/// `sourceId`, unique) — so a cost is counted once, in one place.
/// Never hard-deleted: a wrong entry is voided with a reason.
model Expense {
  id             String    @id @default(cuid())
  expenseNumber  String?   @unique
  date           String
  category       String
  description    String
  amount         Float
  taxAmount      Float     @default(0)
  paymentMethod  String
  paidBy         String?
  vendor         String?
  reference      String?
  jobId          String?
  employeeId     String?
  receiptFileId  String?
  paymentStatus  String    @default("PAID") // PAID | PENDING
  approvalStatus String    @default("APPROVED") // APPROVED | PENDING_APPROVAL | REJECTED
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  sourceType     String? // PAYROLL | FREELANCE | REFERRAL
  sourceId       String?
  idempotencyKey String?   @unique
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceType, sourceId])
  @@index([date])
  @@index([category])
  @@index([jobId])
  @@index([employeeId])
}

/// Receipts, bills and HR documents. Bytes live in the database and are only
/// served by /api/files/[id] after a permission check — never a public URL.
model StoredFile {
  id         String   @id @default(cuid())
  ownerType  String // expense | employee
  ownerId    String?
  category   String? // RECEIPT | ID_PROOF | AGREEMENT | CERTIFICATE | OTHER
  label      String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  data       Bytes
  expiresOn  String?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([ownerType, ownerId])
}

/// Customer referrals and the bonus they may earn. One referral per referred
/// customer / phone, one bonus per qualifying job, paid only after approval.
model Referral {
  id                 String    @id @default(cuid())
  referralNumber     String    @unique
  referrerName       String
  referrerContact    String    @default("")
  referrerCustomerId String?
  referredCustomerId String?   @unique
  referredName       String
  referredContact    String    @default("")
  referredPhoneKey   String?   @unique
  referralDate       String
  source             String    @default("customer")
  qualifyingJobId    String?   @unique
  status             String    @default("CREATED") // CREATED | CUSTOMER_REGISTERED | QUALIFYING_JOB_COMPLETED | BONUS_REVIEW | APPROVED | PAID | REJECTED | EXPIRED
  bonusType          String? // FIXED | PERCENT
  bonusValue         Float?
  bonusAmount        Float?
  approvalStatus     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  paymentStatus      String    @default("UNPAID") // UNPAID | PAID
  paidAt             DateTime?
  paidBy             String?
  paymentMethod      String?
  paymentReference   String?
  expenseId          String?   @unique
  notes              String?
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

/// Staff record for permanent employees, contract staff and freelancers
/// (`employmentType`). Cleaning staff do not need a login; `userId` links the
/// few who do (e.g. a Field Manager). Compensation and personal documents are
/// served only to `hr.sensitive`.
model Employee {
  id                    String             @id @default(cuid())
  employeeCode          String             @unique // EMP-0001 / FRL-0001
  fullName              String
  phone                 String
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employmentType        String             @default("PERMANENT") // PERMANENT | CONTRACT | FREELANCE
  department            String?
  designation           String?
  joiningDate           String?
  status                String             @default("ACTIVE") // ACTIVE | INACTIVE | ON_LEAVE | EXITED
  managerUserId         String?
  userId                String?            @unique
  skills                String[]           @default([])
  serviceCategories     String[]           @default([])
  availabilityNotes     String?
  preferredLocations    String?
  payType               String? // MONTHLY | DAILY | HOURLY | PER_JOB
  payRate               Float?
  verificationStatus    String             @default("PENDING") // PENDING | VERIFIED | REJECTED
  agreementOnFile       Boolean            @default(false)
  notes                 String?
  createdBy             String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assignments           JobAssignment[]
  attendance            AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  payrollRecords        PayrollRecord[]
  freelancePayments     FreelancePayment[]

  @@index([employmentType, status])
  @@index([managerUserId])
}

model AttendanceRecord {
  id                 String    @id @default(cuid())
  employeeId         String
  date               String
  checkIn            DateTime?
  checkOut           DateTime?
  status             String    @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | LEAVE | HOLIDAY | WEEKLY_OFF
  jobId              String?
  verificationMethod String    @default("NONE") // NONE | GPS | QR | MANUAL
  verificationRef    String?
  notes              String?
  recordedBy         String
  correctedBy        String?
  correctedAt        DateTime?
  correctionReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  employee           Employee  @relation(fields: [employeeId], references: [id])
  job                Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  leaveType    String // CASUAL | SICK | PAID | UNPAID | OTHER
  startDate    String
  endDate      String
  days         Float
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedBy  String
  approverId   String?
  approverName String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  employee     Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([startDate])
}

/// One payroll record per employee per month. Net payable is computed on the
/// server. Marking it PAID creates the STAFF_WAGES expense exactly once.
model PayrollRecord {
  id               String    @id @default(cuid())
  employeeId       String
  period           String // YYYY-MM
  periodStart      String
  periodEnd        String
  basic            Float
  allowances       Float     @default(0)
  deductions       Float     @default(0)
  advances         Float     @default(0)
  bonuses          Float     @default(0)
  netPayable       Float
  status           String    @default("DRAFT") // DRAFT | APPROVED | PAID
  notes            String?
  approvedBy       String?
  approvedAt       DateTime?
  paidBy           String?
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  expenseId        String?   @unique
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  employee         Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, period])
}

/// Who is on a job. Several staff per job; one may lead. Rows are never
/// deleted — removal sets status REMOVED and is written to the history.
model JobAssignment {
  id               String            @id @default(cuid())
  jobId            String
  employeeId       String
  role             String            @default("MEMBER") // LEAD | MEMBER
  status           String            @default("ASSIGNED") // ASSIGNED | ACCEPTED | DECLINED | COMPLETED | REMOVED
  rateType         String? // FIXED | HOURLY (freelancers)
  rate             Float?
  expectedHours    Float?
  actualHours      Float?
  assignedBy       String
  assignedAt       DateTime          @default(now())
  respondedAt      DateTime?
  completedAt      DateTime?
  removedAt        DateTime?
  removedReason    String?
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee         Employee          @relation(fields: [employeeId], references: [id])
  freelancePayment FreelancePayment?

  @@unique([jobId, employeeId])
  @@index([employeeId, status])
  @@index([jobId])
}

model JobAssignmentEvent {
  id         String   @id @default(cuid())
  jobId      String
  employeeId String?
  action     String // ASSIGNED | REMOVED | ROLE_CHANGED | ACCEPTED | DECLINED | COMPLETED | MANAGER_CHANGED | TEAM_CONFIRMED | RESCHEDULED
  actorId    String?
  actorName  String
  detail     String?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([employeeId])
}

/// A freelancer's pay for one completed assignment (one payment per assignment).
/// PENDING_VERIFICATION → VERIFIED → APPROVED → PAID; PAID creates the
/// FREELANCE_PAYMENTS expense exactly once.
model FreelancePayment {
  id               String        @id @default(cuid())
  paymentNumber    String        @unique
  assignmentId     String        @unique
  employeeId       String
  jobId            String
  rateType         String // FIXED | HOURLY
  rate             Float
  hours            Float?
  amount           Float
  status           String        @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | VERIFIED | APPROVED | PAID | REJECTED
  verifiedBy       String?
  verifiedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  paidBy           String?
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  expenseId        String?       @unique
  rejectionReason  String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  assignment       JobAssignment @relation(fields: [assignmentId], references: [id])
  employee         Employee      @relation(fields: [employeeId], references: [id])
  job              Job           @relation(fields: [jobId], references: [id])

  @@index([status])
  @@index([employeeId])
}

/// Unified dynamic QR / secure-link token (§3–§6). A QR contains ONLY the
/// random token — every permission decision is made here: purpose, expiry,
/// revocation, and per-use counters. The raw token is never persisted — only
/// its SHA-256 hash — so a database dump cannot mint working links.
model QrToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique // SHA-256 hex of the raw token (verification only)
  tokenEnc      String? // AES-256-GCM encrypted raw token — lets admins re-show the SAME link without minting
  tokenLast4    String // masked display only
  purpose       String // CUSTOMER_JOB | CUSTOMER_VERIFICATION | CUSTOMER_APPROVAL | MANAGER_JOB | QC_INSPECTION | REWORK | REINSPECTION
  jobId         String
  expiresAt     DateTime? // null = governed by job status (e.g. QC link until revoked)
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  usageCount    Int       @default(0)
  lastUsedAt    DateTime?
  createdBy     String?
  createdByName String?
  createdAt     DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([purpose])
  @@index([jobId, purpose])
}

/// Sessions revoked by signing out (kept until the cookie would expire).
model RevokedSession {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model SystemSettings {
  id        String   @id @default("singleton")
  data      Json // full SystemSettings blob (tax, OTP policy, review URL, dispatch cutoff...)
  updatedAt DateTime @updatedAt
}

/// Immutable audit trail (§27): who (user + role), what (action + resource),
/// which job, previous/new state, reason, and device metadata. Rows are only
/// ever inserted — there is no delete path through the application.
model AuditLog {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  performedBy     String // "userId:displayName" ("system:…" for automated steps)
  performedByRole String?
  jobId           String?
  oldState        String?
  newState        String?
  reason          String?
  details         String?
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([jobId])
  @@index([timestamp])
}

/// Real-time pipeline activity event for a job. Written server-side on every
/// field-worker action (arrival, OTP verification, checklist ticks, photo
/// uploads, rework progress) and QC decision so supervisors see a live,
/// auditable feed without polling raw tables.
model JobActivityEvent {
  id        String   @id @default(cuid())
  jobId     String
  type      String // STATUS_CHANGED | OTP_VERIFIED | CHECKLIST_UPDATED | PHOTO_UPLOADED | QC_SUBMITTED | REWORK_ASSIGNED | REWORK_COMPLETED | CUSTOMER_SIGNED | FEEDBACK_RECORDED | STAFF_ASSIGNED | ATTENTION_REQUESTED
  message   String
  actorId   String?
  actorName String
  actorRole String
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
}

/// Audit trail of every outbound SMS dispatch (OTP + completion links).
/// Sensitive payloads (OTP codes, portal tokens) are masked before logging.
model SmsLog {
  id           String   @id @default(cuid())
  jobId        String?
  phone        String // destination (full number retained for delivery audit)
  phoneLast4   String
  purpose      String // OTP_VERIFICATION only now (handover moved to email)
  provider     String // "2factor" | "none" (provider not configured)
  status       String   @default("QUEUED") // QUEUED | SENT | FAILED
  providerRef  String? // 2Factor session id / request reference
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([purpose, createdAt])
}

/// §2 AMC — recurring home-maintenance contract (classic use case: an NRI
/// customer maintaining their elderly parents' home from abroad). Each
/// contract auto-generates AmcVisit rows; a visit is executed with the same
/// OTP → checklist → photos → QC discipline as a regular job.
model AmcContract {
  id                String   @id @default(cuid())
  contractNumber    String   @unique
  customerId        String
  propertyId        String
  serviceId         String? // default service performed each visit
  // NRI owner abroad + trusted local contact on the ground
  nriContactName    String?
  nriContactPhone   String?
  nriContactEmail   String?
  localContactName  String?
  localContactPhone String?
  startDate         String // YYYY-MM-DD
  endDate           String // YYYY-MM-DD
  contractValue     Float
  includedServices  String[] @default([])
  visitCount        Int
  frequency         String   @default("MONTHLY") // WEEKLY | BIMONTHLY | MONTHLY | QUARTERLY | CUSTOM
  assignedStaffIds  String[] @default([])
  emergencyContact  String?
  paymentStatus     String   @default("PENDING") // PENDING | PARTIAL | PAID
  status            String   @default("ACTIVE") // ACTIVE | EXPIRING_SOON | EXPIRED | CANCELLED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id])
  property Property   @relation(fields: [propertyId], references: [id])
  visits   AmcVisit[]

  @@index([customerId])
  @@index([status])
}

/// One scheduled maintenance visit under an AMC contract. Optionally linked
/// to a standard Job record so field execution reuses the strict pipeline.
model AmcVisit {
  id               String    @id @default(cuid())
  contractId       String
  visitNumber      Int
  scheduledDate    String // YYYY-MM-DD
  scheduledSlot    String?
  status           String    @default("SCHEDULED") // SCHEDULED | REMINDED | IN_PROGRESS | COMPLETED | CANCELLED | RESCHEDULED
  jobId            String?   @unique // optional spawned job running the state machine
  arrivedAt        DateTime?
  completedAt      DateTime?
  staffIds         String[]  @default([])
  checklistSummary Json?
  photoUrls        Json?
  qcScore          Int?
  issuesFound      String?
  recommendations  String?
  nriApproved      Boolean?
  nriNotes         String?
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contract AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, scheduledDate])
  @@index([status])
}
