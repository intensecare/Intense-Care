# ============================================================================
# Deep Cleaning Operations ERP — environment template
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ============================================================================

# --- Database (Neon Postgres or any Postgres) --------------------------------
# Connection string with ?sslmode=require for hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Optional: direct (non-pooled) connection used only to apply migrations on deploy.
# DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# SKIP_DB_MIGRATIONS="1"   # set only if migrations are applied some other way

# --- Session signing -----------------------------------------------------------
# 32-byte hex secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
ERP_SESSION_SECRET=""
# Server-side session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- SMS / OTP provider (2Factor.in) ------------------------------------------
# API key from the 2Factor dashboard. Required for customer arrival OTPs —
# the app intentionally has no mock/dummy OTP mode.
TWOFACTOR_API_KEY=""
# Optional DLT sender id if you have your own registration.
TWOFACTOR_SENDER_ID=""
# OTP delivery mode. Leave unset for 2Factor AUTOGEN (provider generates and
# verifies the code through its SHARED pre-approved template — no DLT needed).
# KNOWN ISSUE: on some accounts the shared-template AUTOGEN route silently
# swallows delivery (provider returns Success + session id, handsets never
# receive the SMS). Escape hatches, in order of preference:
#
# 1) autogen_template — set TWOFACTOR_OTP_TEMPLATE to YOUR DLT-registered
#    OTP template name. The provider still generates and verifies the code
#    (session VERIFY flow unchanged), but delivery goes through your own
#    template + sender id (/SMS/{phone}/AUTOGEN/{template_name}). Also set
#    TWOFACTOR_SENDER_ID to your 6-char DLT header if you have one.
# 2) template — additionally set TWOFACTOR_OTP_LOCAL_CODE=1 to generate the
#    6-digit code locally, deliver through your template (VAR1) and verify
#    the SHA-256 hash in the database (no provider session involved).
# TWOFACTOR_OTP_TEMPLATE=""
# TWOFACTOR_OTP_LOCAL_CODE=""
# Super_admins can verify live account credits and the active OTP delivery
# mode at Settings → SMS Gateway Health → Check Live (GET /api/sms/balance)
# without sending any SMS.

# --- Image storage (Cloudinary) ------------------------------------------------
# Required for before/after evidence photo uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder under which job photos are stored.
CLOUDINARY_FOLDER="deep-cleaning-erp"

# --- Operational policy (server-enforced; safe defaults if omitted) ------------
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_SENDS_PER_JOB_PER_HOUR="5"
OTP_MAX_SENDS_PER_PHONE_PER_HOUR="10"
PORTAL_LINK_EXPIRY_DAYS="30"
# Field arrival geofence (metres). Inside = "GPS verified"; outside/unavailable
# requires the field manager to give a reason (recorded on the job + audit log).
# Unused since job start verification moved to Settings → Job start verification
# (distance and GPS accuracy are set there). Kept only so old .env files still load.
ARRIVAL_GEOFENCE_METERS="300"

# --- Google Business Review (customer link end-step CTA) ----------------------
# Public Google review URL for the company. When set, the customer journey page
# shows the "Leave a Google review" button after the customer approves + rates.
GOOGLE_BUSINESS_REVIEW_URL=""

# --- WhatsApp (notifications + links only) -------------------------------------
# WhatsApp Cloud API. With all three set, job notifications (team arrived,
# approve your service, job assigned, rework, QC ready) go out on WhatsApp.
# The template must have ONE body variable ({{1}}) that receives the message.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# Older webhook-style provider (still supported): POST {to, body} to this URL.
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""

# --- Public address -------------------------------------------------------------
# REQUIRED in production. Every customer link and the property QR are built on
# it, e.g. https://your-real-domain.com/customer/service/<secure-token>.
# Links are never built on localhost in production: without this (or a Vercel
# domain) link creation fails loudly instead of sending a broken link.
APP_BASE_URL=""
# debug | info | warn | error
LOG_LEVEL="info"

# --- First-run seed (npm run db:seed) -------------------------------------------
# Credentials for the first Admin account. Remove after seeding.
SEED_SUPERADMIN_EMAIL="admin@yourcompany.com"
SEED_SUPERADMIN_PASSWORD="change-me-at-least-8-chars"
SEED_SUPERADMIN_PHONE=""

# --- OTP dev mode (NEVER set in production) ---------------------------------
# When 1, OTPs are generated locally and returned in the API response instead of
# being sent via SMS. Local development / staging only.
OTP_DEV_MODE=0

# --- Demo sign-in (walkthroughs only) ------------------------------------------
# "true" shows "Try a demo" buttons on the login page (Admin, Field Manager,
# QC, Tax Officer, Customer QR page). Create the demo accounts and sample job
# first with:  npm run db:seed:demo
# Leave unset in production — when off, the buttons and the API are gone.
# DEMO_LOGINS_ENABLED="true"

# --- Intense AI (business assistant) --------------------------------------------
# Server-only key for the AI provider (console.groq.com → API Keys). Never put it
# in a NEXT_PUBLIC_ variable — the browser only talks to /api/ai/chat.
# Without a key, Intense AI shows "not switched on yet" and nothing else changes.
GROQ_API_KEY=your_groq_api_key
# Model id, checked live against Groq's /openai/v1/models before being chosen — Groq retires
# models over time, so re-check that list if this one stops working rather than guessing a new one.
GROQ_MODEL=your_supported_groq_model
# Optional: endpoint override (e.g. a proxy). Root only — the SDK appends /openai/v1/... itself.
# Defaults to https://api.groq.com.
# GROQ_API_BASE="https://api.groq.com"

# --- Maps (job / property location) ----------------------------------------------
# Map tiles and address search run in the browser. OpenStreetMap is the default;
# set these to use another provider (e.g. a paid tile / geocoding service).
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# NEXT_PUBLIC_GEOCODE_URL="https://nominatim.openstreetmap.org"
# Countries address search is limited to (ISO codes, comma-separated; "" = worldwide).
# NEXT_PUBLIC_GEOCODE_COUNTRIES="in"
# Public Nominatim allows ~1 search per second and needs the site's Referer; for
# heavy use run your own Nominatim or a paid geocoder with the same /search and
# /reverse API, and allow your domain in that provider's key restrictions.

# --- Google reviews (Reviews & Feedback page, optional) ---------------------------
# Server-only. Shows your public Google rating and latest reviews next to the
# private feedback. Without them the page still shows private feedback.
# GOOGLE_PLACES_API_KEY=""
# GOOGLE_PLACE_ID=""

# --- Lead Management ---------------------------------------------------------------
# Website enquiry form: the company website's origin(s) allowed to post enquiries
# (the ERP's own /enquiry page always works). Comma-separated, no trailing slash.
# LEAD_FORM_ALLOWED_ORIGINS="https://www.yourcompany.com,https://yourcompany.com"
#
# WhatsApp Business Platform (Cloud API) webhook — official integration only.
# Meta for Developers → App → WhatsApp → Configuration:
#   Callback URL  = APP_BASE_URL/api/webhooks/whatsapp     Verify token = the value below
#   Subscribe to the "messages" field. The app secret verifies every delivery.
# Without both, the webhook answers 503 and stores nothing.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
#
# Google Business Profile performance (aggregate calls / clicks / directions /
# views on the Leads dashboard — never turned into leads). OAuth client authorised
# by an owner or manager of the listing, scope business.manage.
# GOOGLE_BP_CLIENT_ID=""
# GOOGLE_BP_CLIENT_SECRET=""
# GOOGLE_BP_REFRESH_TOKEN=""
# GOOGLE_BP_LOCATION_ID="locations/1234567890"
#
# Google Ads offline conversions: name of the conversion action used in the
# "Google Ads conversions" CSV export on the Leads page (import it in Google Ads).
# GOOGLE_ADS_CONVERSION_NAME="Lead won"

# --- Android app, contact sync, media storage, push notifications ----------------------
# See docs/ANDROID.md.
#
# Scheduler secret. The ERP does not run timers by itself: call
#   GET <APP_BASE_URL>/api/cron/maintenance   with header  Authorization: Bearer <CRON_SECRET>
# about every 15 minutes (Vercel Cron on a paid plan, GitHub Actions, cron-job.org, a VPS cron …).
# It sends job reminders and lead follow-up alerts and purges contacts past their retention period.
# Without CRON_SECRET the endpoint is disabled (503).
# CRON_SECRET=""
#
# Push notifications (Firebase Cloud Messaging, HTTP v1). A Firebase service-account JSON key
# (raw JSON or base64). Server-only — never put it in the app. Without it pushes are skipped, not failed.
# FCM_SERVICE_ACCOUNT_JSON=""
#
# Country code assumed for numbers saved without one (phone-contact matching). Default 91 (India).
# DEFAULT_COUNTRY_CODE="91"
#
# Media & Storage. The provider's own usage is shown when it reports one (Cloudinary does). A limit is only
# shown when the provider states it — or when you set one here (MB). It is never guessed.
# MEDIA_STORAGE_QUOTA_MB=""
# MEDIA_WARN_PERCENT="85"
# Retention before a finished job's photos / financial documents can be removed without a written reason (days).
# MEDIA_EVIDENCE_RETENTION_DAYS="365"
# MEDIA_FINANCIAL_RETENTION_DAYS="2190"
#
# Shown in Device storage (build-time):  NEXT_PUBLIC_APP_VERSION="1.0.0"
#
# Android build (read by capacitor.config.ts / scripts/android-build.sh — build machine only, never secrets):
#   CAP_SERVER_URL   https address of the deployed ERP (required)
#   CAP_APP_ID       Android applicationId (default com.intensecare.erp)
#   CAP_ALLOW_CLEARTEXT=1  debug builds against a LAN dev server only
#   CAP_DEBUG_WEBVIEW=1    allow chrome://inspect on debug builds

# --- Property map links, photo delivery, UPI (optional) -------------------------------
# Address search used when a pasted map link names a place but has no coordinates (server-side).
# Default: OpenStreetMap Nominatim (please respect its usage policy: low volume, real User-Agent — the app sends one).
# GEOCODE_URL="https://nominatim.openstreetmap.org"
#
# Private / custom photo delivery domain (Cloudinary CNAME or private CDN). When set, signed photo links are built on it.
# CLOUDINARY_DELIVERY_HOST="media.yourcompany.com"
#
# TEST ONLY — never set in production: lets the test suite pretend a local host is a Google short-link host.
# MAP_LINK_TEST_HOST="localhost:3998"
#
# The UPI ID / payee name are NOT environment variables: an Admin enters them in Settings → UPI payment.

# --- WhatsApp Business Cloud API (official Meta integration; see docs/WHATSAPP.md) --------------
# SECRETS — set only as server environment variables / in your secret manager. Never commit them.
# WHATSAPP_ACCESS_TOKEN=""              # permanent system-user token (whatsapp_business_messaging + whatsapp_business_management)
# WHATSAPP_APP_SECRET=""                # Meta app secret: webhook signatures (X-Hub-Signature-256) are checked with it
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""      # any long random string; enter the same value in Meta's webhook configuration
# Not secret (an Admin can also enter these in Settings → WhatsApp):
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_GRAPH_VERSION="v21.0"
# Approved template used for automatic customer notifications (job updates); the composed text becomes {{1}}:
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# TEST ONLY — points the app at a stand-in Graph API: WHATSAPP_GRAPH_BASE="http://localhost:3998/graph"
