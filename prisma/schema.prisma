// Laundry operations — the database is the single source of truth.
//
// ONE order is the central object:
//   CREATED → PICKUP_ASSIGNED → PICKED_UP → PROCESSING → QC_PENDING → QC_PASSED
//   → READY → OUT_FOR_DELIVERY → DELIVERED
//   QC_PENDING → QC_FAILED → REWORK → QC_PENDING   (and QC_PENDING → REWORK)
// Allowed transitions live in src/lib/workflow.ts and are enforced by
// src/lib/server/orders.ts. Money is stored in paise (integer minor units).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Staff login roles. Customers never log in — they use a signed order link.
enum Role {
  ADMIN
  FIELD_MANAGER
  QC
}

enum OrderStatus {
  CREATED
  PICKUP_ASSIGNED
  PICKED_UP
  PROCESSING
  QC_PENDING
  QC_FAILED
  REWORK
  QC_PASSED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Lifecycle of a pickup or delivery task assigned to a field manager.
enum TaskStatus {
  PENDING // created, nobody assigned yet
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QCResult {
  PASSED
  FAILED
  REWORK
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PricingUnit {
  PIECE
  KG
  PAIR
  SET
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  role         Role
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pickups    Pickup[]   @relation("PickupAssignee")
  deliveries Delivery[] @relation("DeliveryAssignee")
  qcRecords  QCRecord[]
  payments   Payment[]

  @@index([role, active])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  /// Normalized E.164-style digits (e.g. 919876543210). One customer per phone.
  phone     String   @unique
  email     String?
  address   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
}

/// A priced laundry service (Wash & Fold, Dry Clean, Ironing …). Prices in paise.
model Service {
  id              String      @id @default(cuid())
  name            String
  description     String?
  unit            PricingUnit @default(PIECE)
  price           Int
  turnaroundHours Int         @default(48)
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]
}

model Order {
  id                  String        @id @default(cuid())
  /// Monotonic sequence used to build the human order number (AC1001 …).
  seq                 Int           @unique @default(autoincrement())
  orderNumber         String        @unique
  customerId          String
  status              OrderStatus   @default(CREATED)
  paymentStatus       PaymentStatus @default(UNPAID)
  pickupAddress       String
  deliveryAddress     String
  specialInstructions String?
  subtotal            Int           @default(0)
  discount            Int           @default(0)
  tax                 Int           @default(0)
  total               Int           @default(0)
  amountPaid          Int           @default(0)
  /// Bumping this invalidates the customer's secure link (revocation).
  linkVersion         Int           @default(1)
  cancelReason        String?
  createdById         String?
  readyAt             DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  pickup        Pickup?
  delivery      Delivery?
  qcRecords     QCRecord[]
  payments      Payment[]
  notifications Notification[]
  activity      ActivityLog[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  serviceId   String
  /// Snapshots so later price/name changes never rewrite an order.
  serviceName String
  unit        PricingUnit
  unitPrice   Int
  itemName    String
  quantity    Float
  lineTotal   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderId])
}

model Pickup {
  id           String     @id @default(cuid())
  orderId      String     @unique
  assignedToId String?
  status       TaskStatus @default(PENDING)
  scheduledAt  DateTime?
  completedAt  DateTime?
  notes        String?
  photoUrls    String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("PickupAssignee", fields: [assignedToId], references: [id])

  @@index([assignedToId, status])
}

model Delivery {
  id           String     @id @default(cuid())
  orderId      String     @unique
  assignedToId String?
  status       TaskStatus @default(PENDING)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("DeliveryAssignee", fields: [assignedToId], references: [id])

  @@index([assignedToId, status])
}

model QCRecord {
  id          String   @id @default(cuid())
  orderId     String
  inspectorId String
  result      QCResult
  reason      String?
  createdAt   DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector User  @relation(fields: [inspectorId], references: [id])

  @@index([orderId])
  @@index([result, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Int
  method         PaymentMethod
  reference      String?
  /// Client-generated key so a double-submitted form records one payment.
  idempotencyKey String?       @unique
  receivedById   String?
  createdAt      DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  receivedBy User? @relation(fields: [receivedById], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

/// Every outbound customer/staff message (WhatsApp), sent or not.
model Notification {
  id          String             @id @default(cuid())
  orderId     String?
  recipient   String
  event       String
  message     String
  status      NotificationStatus
  error       String?
  providerRef String?
  createdAt   DateTime           @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

/// Append-only history: every status change and every admin change.
model ActivityLog {
  id         String      @id @default(cuid())
  orderId    String?
  actorId    String?
  actorName  String
  actorRole  String // ADMIN | FIELD_MANAGER | QC | CUSTOMER | SYSTEM
  action     String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  details    String?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdAt])
}

/// Admin-editable business settings (business name, support contact, tax …).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
