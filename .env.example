# ============================================================================
# Deep Cleaning Operations ERP — environment template
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ============================================================================

# --- Database (Neon Postgres or any Postgres) --------------------------------
# Connection string with ?sslmode=require for hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Session signing -----------------------------------------------------------
# 32-byte hex secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
ERP_SESSION_SECRET=""
# Server-side session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- SMS / OTP provider (2Factor.in) ------------------------------------------
# API key from the 2Factor dashboard. Required for customer arrival OTPs —
# the app intentionally has no mock/dummy OTP mode.
TWOFACTOR_API_KEY=""
# Optional DLT sender id if you have your own registration.
TWOFACTOR_SENDER_ID=""
# OTP delivery mode. Leave unset for 2Factor AUTOGEN (provider generates and
# verifies the code through its SHARED pre-approved template — no DLT needed).
# KNOWN ISSUE: on some accounts the shared-template AUTOGEN route silently
# swallows delivery (provider returns Success + session id, handsets never
# receive the SMS). Escape hatches, in order of preference:
#
# 1) autogen_template — set TWOFACTOR_OTP_TEMPLATE to YOUR DLT-registered
#    OTP template name. The provider still generates and verifies the code
#    (session VERIFY flow unchanged), but delivery goes through your own
#    template + sender id (/SMS/{phone}/AUTOGEN/{template_name}). Also set
#    TWOFACTOR_SENDER_ID to your 6-char DLT header if you have one.
# 2) template — additionally set TWOFACTOR_OTP_LOCAL_CODE=1 to generate the
#    6-digit code locally, deliver through your template (VAR1) and verify
#    the SHA-256 hash in the database (no provider session involved).
# TWOFACTOR_OTP_TEMPLATE=""
# TWOFACTOR_OTP_LOCAL_CODE=""
# Super_admins can verify live account credits and the active OTP delivery
# mode at Settings → SMS Gateway Health → Check Live (GET /api/sms/balance)
# without sending any SMS.

# --- Image storage (Cloudinary) ------------------------------------------------
# Required for before/after evidence photo uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder under which job photos are stored.
CLOUDINARY_FOLDER="deep-cleaning-erp"

# --- Operational policy (server-enforced; safe defaults if omitted) ------------
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_SENDS_PER_JOB_PER_HOUR="5"
OTP_MAX_SENDS_PER_PHONE_PER_HOUR="10"
PORTAL_LINK_EXPIRY_DAYS="30"
# Field arrival geofence (metres). Inside = "GPS verified"; outside/unavailable
# requires the field manager to give a reason (recorded on the job + audit log).
# Unused since job start verification moved to Settings → Job start verification
# (distance and GPS accuracy are set there). Kept only so old .env files still load.
ARRIVAL_GEOFENCE_METERS="300"

# --- Google Business Review (customer link end-step CTA) ----------------------
# Public Google review URL for the company. When set, the customer journey page
# shows the "Leave a Google review" button after the customer approves + rates.
GOOGLE_BUSINESS_REVIEW_URL=""

# --- WhatsApp (notifications + links only) -------------------------------------
# WhatsApp Cloud API. With all three set, job notifications (team arrived,
# approve your service, job assigned, rework, QC ready) go out on WhatsApp.
# The template must have ONE body variable ({{1}}) that receives the message.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# Older webhook-style provider (still supported): POST {to, body} to this URL.
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""

# --- Public address -------------------------------------------------------------
# REQUIRED in production. Every customer link and the property QR are built on
# it, e.g. https://your-real-domain.com/customer/service/<secure-token>.
# Links are never built on localhost in production: without this (or a Vercel
# domain) link creation fails loudly instead of sending a broken link.
APP_BASE_URL=""
# debug | info | warn | error
LOG_LEVEL="info"

# --- First-run seed (npm run db:seed) -------------------------------------------
# Credentials for the first Admin account. Remove after seeding.
SEED_SUPERADMIN_EMAIL="admin@yourcompany.com"
SEED_SUPERADMIN_PASSWORD="change-me-at-least-8-chars"
SEED_SUPERADMIN_PHONE=""

# --- OTP dev mode (NEVER set in production) ---------------------------------
# When 1, OTPs are generated locally and returned in the API response instead of
# being sent via SMS. Local development / staging only.
OTP_DEV_MODE=0

# --- Demo sign-in (walkthroughs only) ------------------------------------------
# "true" shows "Try a demo" buttons on the login page (Admin, Field Manager,
# QC, Tax Officer, Customer QR page). Create the demo accounts and sample job
# first with:  npm run db:seed:demo
# Leave unset in production — when off, the buttons and the API are gone.
# DEMO_LOGINS_ENABLED="true"

# --- Intense AI (business assistant) --------------------------------------------
# Server-only key for the AI provider (Google AI Studio → API key). Never put it
# in a NEXT_PUBLIC_ variable — the browser only talks to /api/ai/chat.
# Without a key, Intense AI shows "not switched on yet" and nothing else changes.
# GEMINI_API_KEY=""
# Optional: model (default gemini-2.5-flash) and endpoint override (e.g. a proxy).
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_API_BASE="https://generativelanguage.googleapis.com"

# --- Maps (job / property location) ----------------------------------------------
# Map tiles and address search run in the browser. OpenStreetMap is the default;
# set these to use another provider (e.g. a paid tile / geocoding service).
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# NEXT_PUBLIC_GEOCODE_URL="https://nominatim.openstreetmap.org"

# --- Google reviews (Reviews & Feedback page, optional) ---------------------------
# Server-only. Shows your public Google rating and latest reviews next to the
# private feedback. Without them the page still shows private feedback.
# GOOGLE_PLACES_API_KEY=""
# GOOGLE_PLACE_ID=""
